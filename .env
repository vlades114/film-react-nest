# ==== Docker images (GitHub Container Registry) ====
BACKEND_IMAGE=ghcr.io/vlades114/film-react-nest-backend:latest
FRONTEND_IMAGE=ghcr.io/vlades114/film-react-nest-frontend:latest

# ==== Backend ====
DATABASE_DRIVER=postgres
DATABASE_MODE=local
DATABASE_HOST=database
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=prac
DATABASE_SYNCHRONIZE=false
PORT=3000
CORS_ORIGIN=*
LOGGER_TYPE=json

# ==== Frontend (build-time переменные Vite) ====
VITE_API_URL=/api/afisha
VITE_CDN_URL=/content/afisha

# ==== pgAdmin ====
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
